---
/**
 * "Miesięcznie / Rocznie" switch (real radio inputs).
 * Every element on the page with data-price-monthly / data-price-yearly
 * (see PricingCard) gets its text swapped — tiny inline script, no framework.
 */
interface Props { name?: string; value?: 'monthly' | 'yearly'; }
const { name = 'billing', value = 'monthly' } = Astro.props;
---
<fieldset class="bt" data-billing-toggle>
  <legend class="visually-hidden">Okres rozliczenia</legend>
  <label class="bt__opt"><input type="radio" name={name} value="monthly" checked={value === 'monthly'} /><span>Miesięcznie</span></label>
  <label class="bt__opt"><input type="radio" name={name} value="yearly" checked={value === 'yearly'} /><span>Rocznie</span></label>
</fieldset>

<script>
  document.querySelectorAll<HTMLFieldSetElement>('[data-billing-toggle]').forEach((fs) => {
    const apply = (period: string) => {
      document.querySelectorAll<HTMLElement>('[data-price-monthly]').forEach((el) => {
        const v = el.dataset[period === 'yearly' ? 'priceYearly' : 'priceMonthly'];
        if (v !== undefined) el.textContent = v;
      });
    };
    fs.addEventListener('change', (e) => apply((e.target as HTMLInputElement).value));
    const checked = fs.querySelector<HTMLInputElement>('input:checked');
    if (checked) apply(checked.value);
  });
</script>

<style>
  .bt {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px;
    margin: 0; padding: 4px; border: 0; width: 340px; max-width: 100%;
    background: var(--color-surface-muted); border-radius: var(--radius-pill);
  }
  .bt__opt { position: relative; }
  .bt__opt input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .bt__opt span { display: flex; align-items: center; justify-content: center; min-height: 44px; border-radius: var(--radius-pill); font-size: 15px; font-weight: 800; }
  .bt__opt input:checked + span { background: var(--color-surface); box-shadow: 0 1px 3px rgba(31, 59, 45, 0.2); }
  .bt__opt input:focus-visible + span { outline: 3px solid var(--color-apricot); outline-offset: 2px; }
</style>
