---
/**
 * Pill button. Renders <a> when `href` is given, otherwise <button>.
 * variant:
 *  - primary   dark forest fill (main action; one per view)
 *  - secondary outlined
 *  - ghost     text only, underlined (Cofnij / Przywróć)
 *  - inverse   light fill for dark backgrounds (CTA band)
 *  - accent    apricot fill with dark text (e.g. "Zapisz w planie")
 */
import type { HTMLAttributes } from 'astro/types';
type Variant = 'primary' | 'secondary' | 'ghost' | 'inverse' | 'accent';
type Size = 'sm' | 'md' | 'lg';
interface Props extends Omit<HTMLAttributes<'button'>, 'class'> {
  href?: string;
  variant?: Variant;
  size?: Size;
  block?: boolean;
  iconOnly?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', block = false, iconOnly = false, class: extra, type = 'button', ...rest } = Astro.props;
const cls = ['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', iconOnly && 'btn--icon', extra];
---
{href
  ? <a href={href} class:list={cls} {...rest}><slot /></a>
  : <button type={type} class:list={cls} {...rest}><slot /></button>}

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 44px; border-radius: var(--radius-pill); border: 1.5px solid transparent;
    font-family: var(--font-body); font-weight: 800; line-height: 1.2;
    text-decoration: none; cursor: pointer; white-space: nowrap;
    transition: background-color .15s ease, border-color .15s ease, color .15s ease;
  }
  .btn--sm { font-size: 15px; padding: 10px 16px; }
  .btn--md { font-size: 16px; padding: 13px 22px; }
  .btn--lg { font-size: 18px; padding: 17px 30px; }
  .btn--block { width: 100%; }
  .btn--icon { width: 46px; height: 46px; padding: 0; }

  .btn--primary { background: var(--color-primary); color: var(--color-on-primary); }
  .btn--primary:hover { background: var(--color-primary-2); color: var(--color-on-primary); }

  .btn--secondary { background: transparent; color: var(--color-text); border-color: var(--color-border); font-weight: 700; }
  .btn--secondary:hover { border-color: var(--color-text); color: var(--color-text); }

  .btn--ghost { background: transparent; color: var(--color-text); text-decoration: underline; padding-inline: 12px; }

  .btn--inverse { background: var(--color-on-primary); color: var(--color-primary); }
  .btn--inverse:hover { background: #fff; color: var(--color-primary); }

  .btn--accent { background: var(--color-apricot); color: var(--color-text); }
  .btn--accent:hover { background: #F2AC80; color: var(--color-text); }

  .btn:disabled, .btn[aria-disabled='true'] { opacity: .5; cursor: not-allowed; }
</style>
