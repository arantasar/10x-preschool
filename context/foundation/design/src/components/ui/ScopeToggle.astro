---
/** Segmented control "Jeden dzień / Cały tydzień" built on real radio inputs. */
interface Props { name?: string; value?: 'day' | 'week'; }
const { name = 'scope', value = 'week' } = Astro.props;
---
<fieldset class="seg">
  <legend class="visually-hidden">Zakres</legend>
  <label class="seg__opt">
    <input type="radio" name={name} value="day" checked={value === 'day'} />
    <span>Jeden dzień</span>
  </label>
  <label class="seg__opt">
    <input type="radio" name={name} value="week" checked={value === 'week'} />
    <span>Cały tydzień</span>
  </label>
</fieldset>

<style>
  .seg {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px;
    margin: 0; padding: 4px; border: 0; border-radius: var(--radius-pill);
    background: var(--color-surface-muted);
  }
  .seg__opt { position: relative; }
  .seg__opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg__opt span {
    display: flex; align-items: center; justify-content: center; min-height: 44px;
    border-radius: var(--radius-pill); font-size: 15px; font-weight: 700; color: var(--color-text);
  }
  .seg__opt input:checked + span {
    background: var(--color-surface); font-weight: 800; box-shadow: 0 1px 3px rgba(31, 59, 45, 0.2);
  }
  .seg__opt input:focus-visible + span { outline: 3px solid var(--color-apricot); outline-offset: 2px; }
</style>
