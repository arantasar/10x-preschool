---
/** Hero pill-shaped topic input with the submit button inside (landing page). Stacks on mobile. */
interface Props { action?: string; method?: 'get' | 'post'; value?: string; placeholder?: string; }
const { action = '/generuj', method = 'get', value = '', placeholder = 'np. Dinozaury' } = Astro.props;
---
<form class="topic" action={action} method={method}>
  <div class="topic__bar">
    <label for="topic-input" class="topic__label">Temat</label>
    <input id="topic-input" name="topic" class="topic__input" value={value} placeholder={placeholder} required autocomplete="off" />
    <button type="submit" class="topic__submit">Wygeneruj propozycje</button>
  </div>
  <p class="topic__note">Nic nie trafia do planu bez Twojej akceptacji.</p>
</form>

<style>
  .topic { display: flex; flex-direction: column; align-items: center; gap: 14px; width: 100%; max-width: 760px; }
  .topic__bar {
    display: flex; align-items: center; gap: 8px; width: 100%;
    background: var(--color-surface); border-radius: var(--radius-pill);
    padding: 8px 8px 8px 28px; box-shadow: var(--shadow-input);
  }
  .topic__label { font-weight: 700; font-size: 15px; color: var(--color-text-accent); }
  .topic__input {
    flex: 1; min-width: 0; font: inherit; font-size: 22px; font-weight: 700;
    color: var(--color-text); border: 0; background: transparent; padding: 12px;
  }
  .topic__input:focus { outline: none; }
  .topic__bar:focus-within { box-shadow: var(--shadow-input), 0 0 0 3px var(--color-apricot); }
  .topic__submit {
    font: inherit; font-size: 17px; font-weight: 800; padding: 16px 26px; min-height: 44px;
    border: 0; border-radius: var(--radius-pill); background: var(--color-primary); color: var(--color-on-primary); cursor: pointer;
  }
  .topic__note { font-size: 15px; color: var(--color-text-muted); }

  @media (max-width: 640px) {
    .topic__bar { flex-direction: column; align-items: stretch; background: transparent; box-shadow: none; padding: 0; gap: 10px; }
    .topic__bar:focus-within { box-shadow: none; }
    .topic__input { background: var(--color-surface); border-radius: 18px; padding: 16px 18px; font-size: 20px; box-shadow: var(--shadow-input); }
    .topic__input:focus { box-shadow: var(--shadow-input), 0 0 0 3px var(--color-apricot); }
    .topic__label { font-weight: 800; font-size: 14px; }
    .topic__submit { padding: 17px; }
  }
</style>
