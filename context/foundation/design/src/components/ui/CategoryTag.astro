---
/**
 * Activity category pill. Known categories get their own color pair;
 * anything else (LLM may return new ones) falls back to neutral.
 */
interface Props { category: string; }
const { category } = Astro.props;
const known: Record<string, string> = {
  'ruch': 'ruch',
  'plastyka': 'plastyka',
  'mowa': 'mowa',
  'odkrywanie': 'odkrywanie',
  'muzyka': 'muzyka',
};
const key = known[category.trim().toLowerCase()] ?? 'default';
---
<span class="tag" style={`--tag-bg: var(--cat-${key}-bg); --tag-fg: var(--cat-${key}-fg);`}>{category}</span>

<style>
  .tag {
    display: inline-block; background: var(--tag-bg); color: var(--tag-fg);
    font-size: var(--text-tag); font-weight: 800; line-height: 1.3;
    padding: 5px 12px; border-radius: var(--radius-pill); white-space: nowrap;
  }
</style>
