---
/** Public footer: logo · Cennik / FAQ / Regulamin / Kontakt · copyright. */
import Logo from '../ui/Logo.astro';
type Page = 'cennik' | 'faq' | 'regulamin' | 'kontakt' | undefined;
interface Props { active?: Page; year?: number | string; }
const { active, year = new Date().getFullYear() } = Astro.props;
const links = [
  { key: 'cennik', label: 'Cennik', href: '/cennik' },
  { key: 'faq', label: 'FAQ', href: '/faq' },
  { key: 'regulamin', label: 'Regulamin', href: '/regulamin' },
  { key: 'kontakt', label: 'Kontakt', href: '/kontakt' },
];
---
<footer class="sf">
  <Logo size="sm" />
  <nav class="sf__nav" aria-label="Stopka">
    {links.map((l) => <a href={l.href} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <small class="sf__copy">© {year} 10xPreschool</small>
</footer>

<style>
  .sf {
    margin-top: auto; padding: 44px var(--page-gutter);
    display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
    border-top: 1.5px solid var(--color-divider);
  }
  .sf__nav { display: flex; gap: 8px; flex-wrap: wrap; }
  .sf__nav a { font-weight: 700; font-size: 15px; padding: 12px; }
  .sf__nav a[aria-current='page'] { font-weight: 800; }
  .sf__copy { font-size: 15px; color: var(--color-text-muted); }
  @media (max-width: 640px) {
    .sf { flex-direction: column; align-items: flex-start; padding: 32px 20px; }
    .sf__nav { margin-left: -12px; }
  }
</style>
