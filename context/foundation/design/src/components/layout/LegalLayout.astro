---
/**
 * Long legal / policy text (Regulamin, Polityka prywatności).
 * Left: table of contents; right: prose in the default slot.
 * Works with plain HTML or rendered Markdown (content collection): give each section an id
 * matching `toc[].id`, and use <h2> per paragraph (§).
 * ≤ 900px: TOC becomes a collapsible <details> above the text.
 */
interface TocItem { id: string; label: string; }
interface Props { title: string; toc: TocItem[]; effectiveDate?: string; version?: string; }
const { title, toc, effectiveDate, version } = Astro.props;
---
<div class="legal">
  <nav class="legal__toc" aria-label="Spis treści">
    <details open>
      <summary class="legal__toc-title">Spis treści</summary>
      <ol>
        {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
      </ol>
    </details>
  </nav>
  <article class="legal__body">
    <header class="legal__head">
      <h1>{title}</h1>
      {(effectiveDate || version) && (
        <p class="legal__meta">
          {effectiveDate && <span>Obowiązuje od: {effectiveDate}</span>}
          {version && <span>Wersja: {version}</span>}
        </p>
      )}
    </header>
    <div class="legal__prose"><slot /></div>
  </article>
</div>

<style>
  .legal { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 80px; padding: 56px var(--page-gutter) 96px; align-items: start; }
  .legal__toc { position: sticky; top: 24px; background: var(--color-surface); border-radius: var(--radius-lg); padding: 20px; }
  .legal__toc-title { list-style: none; font-weight: 800; font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--color-text-accent); padding: 6px 12px 10px; }
  .legal__toc-title::-webkit-details-marker { display: none; }
  .legal__toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .legal__toc a { display: block; font-weight: 700; font-size: 15px; text-decoration: none; padding: 10px 12px; border-radius: 12px; }
  .legal__toc a:hover { background: var(--color-sage-soft); color: var(--color-text); }

  .legal__body { max-width: 760px; display: flex; flex-direction: column; gap: 44px; }
  .legal__head { display: flex; flex-direction: column; gap: 14px; }
  .legal__head h1 { font-size: clamp(44px, 4.4vw, 64px); line-height: 1.05; }
  .legal__meta { display: flex; gap: 20px; flex-wrap: wrap; font-size: 15px; font-weight: 700; color: var(--color-text-accent); }

  .legal__prose { display: flex; flex-direction: column; gap: 14px; font-size: 17px; line-height: 1.65; color: #2F4639; }
  .legal__prose :global(section) { display: flex; flex-direction: column; gap: 14px; scroll-margin-top: 24px; }
  .legal__prose :global(section + section) { margin-top: 30px; }
  .legal__prose :global(h2) { font-size: 28px; line-height: 1.2; color: var(--color-text); }
  .legal__prose :global(h2 .num) { color: var(--color-text-accent); margin-right: 6px; }
  .legal__prose :global(ol), .legal__prose :global(ul) { margin: 0; padding-left: 24px; display: flex; flex-direction: column; gap: 10px; }
  .legal__prose :global(dl) { margin: 0; display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 12px 24px; }
  .legal__prose :global(dt) { font-weight: 800; color: var(--color-text); }
  .legal__prose :global(dd) { margin: 0; }

  @media (max-width: 900px) {
    .legal { grid-template-columns: 1fr; gap: 32px; padding: 24px 20px 64px; }
    .legal__toc { position: static; }
    .legal__toc details:not([open]) { padding-bottom: 0; }
    .legal__prose :global(dl) { grid-template-columns: 1fr; gap: 4px; }
    .legal__prose :global(dd) { margin-bottom: 10px; }
  }
</style>
