---
/**
 * Logged-in app bar: logo · main nav (active item = sage pill) · AccountMenu (avatar + dropdown).
 * Pass the signed-in user's email (and optionally name for the initial).
 */
import Logo from '../ui/Logo.astro';
import AccountMenu from './AccountMenu.astro';
interface Props {
  active?: 'plan' | 'generate';
  email: string;
  name?: string;
  planHref?: string;
  generateHref?: string;
}
const { active, email, name, planHref = '/plan', generateHref = '/generuj' } = Astro.props;
const items = [
  { key: 'plan', label: 'Plan miesiąca', href: planHref },
  { key: 'generate', label: 'Nowe propozycje', href: generateHref },
];
---
<header class="ah">
  <div class="ah__side"><Logo href={planHref} /></div>
  <nav class="ah__nav" aria-label="Główna">
    {items.map((i) => (
      <a href={i.href} class:list={['ah__item', active === i.key && 'is-active']} aria-current={active === i.key ? 'page' : undefined}>{i.label}</a>
    ))}
  </nav>
  <div class="ah__side ah__side--end"><AccountMenu email={email} name={name} /></div>
</header>

<style>
  .ah {
    position: relative; z-index: 40;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 14px var(--app-gutter);
    background: var(--color-surface); border-bottom: 1.5px solid #E2DBC8;
  }
  .ah__side { flex: 1; display: flex; }
  .ah__side--end { justify-content: flex-end; }
  .ah__nav { display: flex; gap: 6px; }
  .ah__item { font-weight: 700; font-size: 16px; text-decoration: none; padding: 12px 18px; border-radius: var(--radius-pill); white-space: nowrap; }
  .ah__item.is-active { font-weight: 800; background: var(--color-sage-soft); }
  @media (max-width: 720px) {
    .ah { flex-wrap: wrap; }
    .ah__nav { order: 3; width: 100%; }
    .ah__item { flex: 1; text-align: center; padding: 10px 12px; font-size: 15px; }
  }
</style>
