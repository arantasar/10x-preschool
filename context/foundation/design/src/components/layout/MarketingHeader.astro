---
/**
 * Public header for all marketing / info pages.
 * Desktop: logo · Cennik · FAQ · Kontakt | Zaloguj się · [Załóż konto]
 * ≤ 900px: links collapse into a native <details> menu (no JS needed).
 * `active` highlights the current page with a sage pill (aria-current="page").
 */
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
type Page = 'cennik' | 'faq' | 'kontakt' | undefined;
interface Props {
  active?: Page;
  loginHref?: string; signupHref?: string;
  pricingHref?: string; faqHref?: string; contactHref?: string;
}
const {
  active, loginHref = '/logowanie', signupHref = '/rejestracja',
  pricingHref = '/cennik', faqHref = '/faq', contactHref = '/kontakt',
} = Astro.props;
const links = [
  { key: 'cennik', label: 'Cennik', href: pricingHref },
  { key: 'faq', label: 'FAQ', href: faqHref },
  { key: 'kontakt', label: 'Kontakt', href: contactHref },
];
---
<header class="mh">
  <Logo size="lg" />

  <nav class="mh__nav" aria-label="Główna">
    {links.map((l) => (
      <a href={l.href} class:list={['mh__link', active === l.key && 'is-active']} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
    <span class="mh__sep" aria-hidden="true"></span>
    <a class="mh__link" href={loginHref}>Zaloguj się</a>
    <Button href={signupHref}>Załóż konto</Button>
  </nav>

  <details class="mh__mobile">
    <summary class="mh__burger" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </summary>
    <div class="mh__panel">
      {links.map((l) => (
        <a href={l.href} class:list={['mh__plink', active === l.key && 'is-active']} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="mh__plink" href={loginHref}>Zaloguj się</a>
      <Button href={signupHref} block>Załóż konto</Button>
    </div>
  </details>
</header>

<style>
  .mh {
    position: relative; z-index: 2;
    display: flex; justify-content: space-between; align-items: center;
    padding: 30px var(--page-gutter);
  }
  .mh__nav { display: flex; align-items: center; gap: 8px; }
  .mh__link { font-weight: 700; font-size: 16px; text-decoration: none; padding: 12px 16px; border-radius: var(--radius-pill); }
  .mh__link.is-active { font-weight: 800; background: var(--color-sage-soft); }
  .mh__sep { width: 1.5px; height: 24px; background: var(--color-divider); margin: 0 8px; }

  .mh__mobile { display: none; position: relative; }
  .mh__burger {
    list-style: none; cursor: pointer; width: 44px; height: 44px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; background: var(--color-surface);
  }
  .mh__burger::-webkit-details-marker { display: none; }
  .mh__panel {
    position: absolute; right: 0; top: 54px; width: min(320px, calc(100vw - 40px));
    background: var(--color-surface); border-radius: var(--radius-xl); padding: 12px;
    box-shadow: var(--shadow-panel); display: flex; flex-direction: column; gap: 4px;
  }
  .mh__plink { font-weight: 700; font-size: 17px; text-decoration: none; padding: 14px 16px; border-radius: var(--radius-md); }
  .mh__plink.is-active { background: var(--color-sage-soft); font-weight: 800; }

  @media (max-width: 900px) {
    .mh { padding: 18px 20px; }
    .mh__nav { display: none; }
    .mh__mobile { display: block; }
  }
</style>
