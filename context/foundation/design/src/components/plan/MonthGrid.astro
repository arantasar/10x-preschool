---
/**
 * Month overview: one row per week, Mon–Fri columns, weekly theme on the left.
 * Day status: approved (sage fill) | pending (dashed) | outside (blank, day not in month) .
 * A week with no theme (`theme` empty) renders one wide "empty" cell with a CTA.
 * < 900px: rows become stacked lists (theme header + day list).
 */
import CategoryTag from '../ui/CategoryTag.astro';

export interface MonthDay {
  day: number | null;              // null → outside month
  title?: string;
  category?: string;
  status: 'approved' | 'pending' | 'outside';
}
export interface MonthWeek {
  theme?: string;                  // "Dinozaury"; empty → week without plan
  rangeLabel: string;              // "5–9 października"
  days: MonthDay[];                // always 5 (Mon–Fri)
  ctaHref?: string;                // for empty weeks
}
interface Props { weeks: MonthWeek[]; }
const { weeks } = Astro.props;
const dayNames = ['Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek'];
---
<div class="month" role="table" aria-label="Plan miesiąca">
  <div class="month__head" role="row">
    <span role="columnheader"><span class="visually-hidden">Temat tygodnia</span></span>
    {dayNames.map((d) => <span role="columnheader" class="month__dayname">{d}</span>)}
  </div>

  {weeks.map((w) => (
    <div class:list={['month__week', !w.theme && 'is-empty']} role="row">
      <div class="month__theme" role="rowheader">
        <span class="month__theme-name">{w.theme || 'Bez tematu'}</span>
        <span class="month__range">{w.rangeLabel}</span>
      </div>
      {w.theme ? (
        w.days.map((d) =>
          d.status === 'outside' ? (
            <div class="cell cell--outside" role="cell" aria-hidden="true"></div>
          ) : (
            <div class:list={['cell', `cell--${d.status}`]} role="cell">
              <span class="cell__num">{d.day}</span>
              <span class="cell__title">{d.title}</span>
              {d.category && <CategoryTag category={d.category} />}
              <span class="visually-hidden">{d.status === 'approved' ? 'Zatwierdzone' : 'Do przejrzenia'}</span>
            </div>
          )
        )
      ) : (
        <div class="cell cell--empty" role="cell">
          <span>Ten tydzień czeka na temat.</span>
          {w.ctaHref && <a class="cell__cta" href={w.ctaHref}>Wpisz hasło na {w.rangeLabel}</a>}
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .month { display: flex; flex-direction: column; gap: 10px; }
  .month__head, .month__week {
    display: grid; grid-template-columns: 200px repeat(5, minmax(0, 1fr)); gap: 10px;
  }
  .month__dayname { font-size: var(--text-meta); font-weight: 800; color: var(--color-text-accent); padding: 0 6px; }
  .month__theme { display: flex; flex-direction: column; justify-content: center; gap: 2px; padding-right: 8px; }
  .month__theme-name { font-family: var(--font-display); font-size: 19px; line-height: 1.2; }
  .is-empty .month__theme-name { color: var(--color-text-muted); }
  .month__range { font-size: 13px; font-weight: 700; color: var(--color-text-accent); }

  .cell {
    min-height: 118px; border-radius: 18px; padding: 14px;
    display: flex; flex-direction: column; align-items: flex-start; gap: 6px;
  }
  .cell--approved { background: var(--status-approved-bg); border: 1.5px solid var(--status-approved-border); }
  .cell--pending { background: var(--color-surface); border: 1.5px dashed var(--status-pending-border); }
  .cell__num { font-family: var(--font-display); font-size: 18px; line-height: 1; }
  .cell__title { font-size: 15px; font-weight: 800; line-height: 1.3; }
  .cell--empty {
    grid-column: span 5; background: var(--status-empty-bg);
    flex-direction: row; align-items: center; justify-content: center; gap: 18px;
    font-size: 16px; font-weight: 700; color: var(--color-text-muted);
  }
  .cell__cta {
    font-weight: 800; padding: 13px 22px; border-radius: var(--radius-pill);
    background: var(--color-primary); color: var(--color-on-primary); text-decoration: none;
  }
  .cell__cta:hover { color: var(--color-on-primary); background: var(--color-primary-2); }

  @media (max-width: 900px) {
    .month__head { display: none; }
    .month__week { grid-template-columns: 1fr; }
    .month__theme { padding: 12px 0 4px; }
    .cell { min-height: 0; }
    .cell--outside { display: none; }
    .cell--empty { grid-column: auto; flex-direction: column; padding: 24px; text-align: center; }
  }
</style>
