---
/** Collapsed placeholder for a proposal the teacher removed — lets them restore it. */
import Button from '../ui/Button.astro';
interface Props { id: string; dayLabel: string; title: string; }
const { id, dayLabel, title } = Astro.props;
---
<div class="removed" data-id={id}>
  <span><strong>{dayLabel}</strong> · usunięto „{title}”</span>
  <Button size="sm" variant="ghost" data-action="restore" data-id={id}>Przywróć</Button>
</div>

<style>
  .removed {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    border: 1.5px dashed var(--color-border); border-radius: var(--radius-lg);
    padding: 8px 12px 8px 24px; font-size: 15px; color: var(--color-text-muted);
  }
</style>
