SUPABASE_URL=###
SUPABASE_KEY=###
OPENROUTER_API_KEY=###
# Musi byc jedna z wartosci z ALLOWED_MODELS w src/lib/services/allowed-models.ts -
# inna wartosc jest bledem konfiguracji, nie cichym powrotem do domyslnej.
# Uzasadnienie wyboru: context/archive/2026-08-22-first-day-generation/model-comparison.md
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Formularz kontaktowy (/kontakt). Lokalnie i w e2e: klucze testowe Turnstile, ktore
# zawsze przechodza (site 1x00000000000000000000AA, secret
# 1x0000000000000000000000000000000AA); secret 2x0000000000000000000000000000000AA
# zawsze odrzuca. Bez CONTACT_TO wiadomosc trafia tylko do bazy (log
# contact.mail_skipped) - tak ma byc lokalnie, zeby e2e nie wysylalo poczty.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CONTACT_TO=
