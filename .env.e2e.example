# Konfiguracja testow e2e (Playwright). Skopiuj do `.env.e2e` (gitignored).
#
# Testy e2e MUSZA celowac w lokalna Supabase (`npx supabase start`), nigdy w
# projekt produkcyjny: zakladaja konta testowe i kasuja plany dni. Wartosci
# ponizej to domyslne, deterministyczne dane lokalnego stacku - odczytasz je
# w kazdej chwili przez `npx supabase status`.
#
# Adres musi sie zgadzac z SUPABASE_URL w `.dev.vars`, bo to ten plik czyta
# serwer dev uruchamiany przez Playwrighta (runtime Cloudflare, nie `.env`).
E2E_SUPABASE_URL=http://127.0.0.1:54321

# Klucz serwisowy (secret) - omija RLS. Uzywany WYLACZNIE do zakladania kont
# testowych, zasiewania planow i sprzatania po tescie. Zadna asercja nie moze
# przez niego czytac: to on omija dokladnie te granice, ktorych pilnuje ryzyko
# #4, wiec asercja na nim oparta nie udowodniloby niczego.
E2E_SUPABASE_SECRET_KEY=sb_secret_...

# Haslo obu kont testowych. Dowolne, min. 6 znakow (tyle wymusza Supabase).
E2E_PASSWORD=e2e-test-password
