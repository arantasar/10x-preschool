---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
import SettingsLayout from "@/components/account/SettingsLayout.astro";
import PasswordChangeForm from "@/components/account/PasswordChangeForm";
import DeleteAccountForm from "@/components/account/DeleteAccountForm";
import {
  DELETE_ACCOUNT_ANCHOR,
  DELETE_ERROR_PARAM,
  PASSWORD_CHANGED_COOKIE,
  PASSWORD_CHANGED_COOKIE_OPTIONS,
} from "@/lib/account-settings";
import { accessCard, readAccountEntitlement } from "@/lib/account-entitlement";
import { authErrorMessage } from "@/lib/auth-error-messages";
import { todayIsoDate } from "@/lib/day-plan-dates";
import { PRIVACY_PATH, TERMS_PATH } from "@/lib/legal";

// Protected by the middleware (`PROTECTED_ROUTES`), so a user is always here.
const { user, supabase } = Astro.locals;

// Shown only while full access lasts. No row (an account from before payments),
// a past date or a failed read all mean no card - the read logs its own failure.
const access = accessCard(supabase ? await readAccountEntitlement(supabase) : null, todayIsoDate());

// One-shot: set by `/api/auth/change-password`, consumed by the first render
// that shows it, so a reload removes the notice by construction.
const passwordChanged = Astro.cookies.has(PASSWORD_CHANGED_COOKIE);
if (passwordChanged) {
  Astro.cookies.delete(PASSWORD_CHANGED_COOKIE, { path: PASSWORD_CHANGED_COOKIE_OPTIONS.path });
}

// Only when present: the lookup never returns an empty string, and the error
// box hides itself only on a falsy message.
const errorCode = Astro.url.searchParams.get("error");
const serverError = errorCode ? authErrorMessage(errorCode) : null;

// The deletion card's own slot: `?error=` stays the password form's.
const deleteErrorCode = Astro.url.searchParams.get(DELETE_ERROR_PARAM);
const deleteServerError = deleteErrorCode ? authErrorMessage(deleteErrorCode) : null;

const card = "bg-mleko rounded-card flex flex-col px-5 py-6 min-[901px]:px-9 min-[901px]:py-8";
---

<PlannerLayout title="Ustawienia" active="account">
  <main>
    <SettingsLayout active="konto">
      <section aria-labelledby="konto-heading" class:list={[card, "gap-3.5"]}>
        <h2 id="konto-heading" class="font-display text-display-sm text-las">Konto</h2>
        <div
          class="bg-owies flex flex-col gap-2 rounded-2xl px-5 py-4 min-[600px]:flex-row min-[600px]:items-center min-[600px]:justify-between min-[600px]:gap-6"
        >
          <div class="flex min-w-0 flex-col gap-0.5">
            <p class="text-mech text-sm font-extrabold">E-mail</p>
            <p class="text-las text-lg font-bold break-all">{user?.email}</p>
          </div>
          <p class="text-las-szary max-w-[320px] text-sm min-[600px]:text-right">
            Na ten adres wysyłamy linki do aktywacji i resetu hasła.
          </p>
        </div>
        {
          access && (
            <div class="bg-owies flex flex-col gap-2 rounded-2xl px-5 py-4 min-[600px]:flex-row min-[600px]:items-center min-[600px]:justify-between min-[600px]:gap-6">
              <div class="flex min-w-0 flex-col gap-0.5">
                <p class="text-mech text-sm font-extrabold">Dostęp</p>
                <p class="text-las text-lg font-bold">Pełny dostęp — do {access.untilLabel}</p>
              </div>
              <p class="text-las-szary max-w-[320px] text-sm min-[600px]:text-right">
                Wszystkie funkcje Temio są dziś bezpłatne.
              </p>
            </div>
          )
        }
        {/* A signed-in teacher never sees the public footer, so the documents are linked here. */}
        <nav aria-label="Dokumenty" class="flex flex-wrap gap-x-5 gap-y-1">
          <a
            href={TERMS_PATH}
            class="text-las hover:text-mech inline-flex min-h-11 items-center text-[15px] font-bold underline underline-offset-4"
          >
            Regulamin
          </a>
          <a
            href={PRIVACY_PATH}
            class="text-las hover:text-mech inline-flex min-h-11 items-center text-[15px] font-bold underline underline-offset-4"
          >
            Polityka prywatności
          </a>
        </nav>
      </section>

      <section id="haslo" aria-labelledby="haslo-heading" class:list={[card, "scroll-mt-6 gap-5"]}>
        <div class="flex flex-col gap-1.5">
          <h2 id="haslo-heading" class="font-display text-display-sm text-las">Zmień hasło</h2>
          <p class="text-las-szary text-base">
            Po zmianie hasła pozostaniesz zalogowana lub zalogowany na tym urządzeniu, a na pozostałych trzeba będzie
            zalogować się ponownie.
          </p>
        </div>
        {
          passwordChanged && (
            <p class="rounded-input bg-szalwia-soft text-mech-ciemny px-4 py-3 text-[15px] font-semibold" role="status">
              Hasło zostało zmienione. Na innych urządzeniach trzeba zalogować się ponownie.
            </p>
          )
        }
        <PasswordChangeForm client:load serverError={serverError} email={user?.email} />
      </section>

      <section
        id={DELETE_ACCOUNT_ANCHOR}
        aria-labelledby="usun-konto-heading"
        class:list={[card, "border-blad-ramka scroll-mt-6 gap-5 border-[1.5px]"]}
      >
        <div class="flex flex-col gap-1.5">
          <h2 id="usun-konto-heading" class="font-display text-display-sm text-blad">Usuń konto</h2>
          <p class="text-las-szary text-base">
            Razem z kontem usuniemy wszystkie Twoje plany i propozycje. Tej operacji nie można cofnąć.
          </p>
        </div>
        {user?.email && <DeleteAccountForm client:load serverError={deleteServerError} email={user.email} />}
      </section>
    </SettingsLayout>
  </main>
</PlannerLayout>
