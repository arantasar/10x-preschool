---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/layout/AuthCard.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";
import { authErrorMessage } from "@/lib/auth-error-messages";

// Mock-up 12. Also where every failed step of the reset lands - an expired or
// invalid link, a missing session - so the explanation sits right above the
// form that sends a new link.
//
// `?error=` carries a code, not a sentence; an absent parameter short-circuits
// the lookup for the same reason as on `signin.astro`.
const errorCode = Astro.url.searchParams.get("error");
const serverError = errorCode ? authErrorMessage(errorCode) : null;
---

<Layout title="Nie pamiętasz hasła?">
  <AuthCard>
    <div class="flex flex-col gap-3">
      <h1 class="font-display text-las text-[clamp(32px,4vw,42px)] leading-[1.1] font-normal">Nie pamiętasz hasła?</h1>
      <p class="text-las-szary text-lg leading-normal">
        Podaj e-mail konta. Wyślemy na niego link do ustawienia nowego hasła.
      </p>
    </div>
    <ForgotPasswordForm serverError={serverError} client:load />
    <p class="text-center">
      <a href="/auth/signin" class="text-las hover:text-mech font-extrabold underline">Wróć do logowania</a>
    </p>
  </AuthCard>
</Layout>
