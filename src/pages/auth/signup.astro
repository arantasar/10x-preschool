---
import Layout from "@/layouts/Layout.astro";
import AuthSplit from "@/components/layout/AuthSplit.astro";
import HowItWorksSteps from "@/components/marketing/HowItWorksSteps.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { authErrorMessage } from "@/lib/auth-error-messages";
import { normalizePendingTopic, PENDING_TOPIC_COOKIE, PENDING_TOPIC_COOKIE_OPTIONS } from "@/lib/pending-topic";

// `?error=` carries a code, not a sentence. An absent parameter has to
// short-circuit rather than go through the lookup: the lookup is
// contractually non-empty, and `ServerError` hides itself only on a falsy
// message - passing it a translated string would show the box on every
// clean page load.
const errorCode = Astro.url.searchParams.get("error");
const serverError = errorCode ? authErrorMessage(errorCode) : null;

// The landing's topic form lands here with `?haslo=`. It is parked in a cookie,
// because the session that will use it is born only after the e-mail
// confirmation and a separate sign-in - see `@/lib/pending-topic`. A hasło
// already waiting from an earlier visit is acknowledged too.
//
// The notice never echoes the value. `?haslo=` is free text anyone can put in a
// link, and quoting it would render an arbitrary sentence inside our own box -
// right above a field labelled "Hasło" (password) - the same hole `?error=`
// closed by carrying codes (`supabase-error-copy`). The teacher sees her topic
// where it matters: in the week form after signing in.
const fromLanding = normalizePendingTopic(Astro.url.searchParams.get("haslo"));
if (fromLanding) {
  Astro.cookies.set(PENDING_TOPIC_COOKIE, fromLanding, PENDING_TOPIC_COOKIE_OPTIONS);
}
const pendingTopic = fromLanding ?? normalizePendingTopic(Astro.cookies.get(PENDING_TOPIC_COOKIE)?.value);
---

<Layout title="Załóż konto">
  <AuthSplit>
    <div class="flex flex-col gap-2">
      <h1 class="font-display text-las text-[clamp(36px,3.4vw,48px)] leading-[1.1] font-normal">Załóż konto</h1>
      <p class="text-las-szary">Zacznij planować zajęcia od jednego hasła.</p>
    </div>
    {
      pendingTopic && (
        <p class="rounded-input bg-szalwia-soft text-mech-ciemny px-4 py-3 text-[15px] font-semibold" role="status">
          Temat wpisany na stronie głównej poczeka na Ciebie po zalogowaniu.
        </p>
      )
    }
    <SignUpForm serverError={serverError} client:load />
    <p class="border-linia text-las-szary border-t-[1.5px] pt-5 text-center text-base">
      Masz już konto? <a href="/auth/signin" class="text-las hover:text-mech font-extrabold underline">Zaloguj się</a>
    </p>

    <Fragment slot="panel">
      <p class="font-display text-owies text-[clamp(40px,3.9vw,56px)] leading-[1.05]">
        Trzy kroki<br />do <em class="text-szalwia">gotowego planu.</em>
      </p>
      <HowItWorksSteps variant="panel" />
    </Fragment>
  </AuthSplit>
</Layout>
