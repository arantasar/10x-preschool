---
import Layout from "@/layouts/Layout.astro";
import AuthSplit from "@/components/layout/AuthSplit.astro";
import SampleDayCard from "@/components/marketing/SampleDayCard.astro";
import SignInForm from "@/components/auth/SignInForm";
import { authErrorMessage } from "@/lib/auth-error-messages";
import { normalizePendingTopic, PENDING_TOPIC_COOKIE, PENDING_TOPIC_COOKIE_OPTIONS } from "@/lib/pending-topic";

// `?error=` carries a code, not a sentence. An absent parameter has to
// short-circuit rather than go through the lookup: the lookup is
// contractually non-empty, and `ServerError` hides itself only on a falsy
// message - passing it a translated string would show the box on every
// clean page load.
const errorCode = Astro.url.searchParams.get("error");
const serverError = errorCode ? authErrorMessage(errorCode) : null;

// A `?haslo=` link aimed at sign-in parks the hasło the same way sign-up does.
const fromLanding = normalizePendingTopic(Astro.url.searchParams.get("haslo"));
if (fromLanding) {
  Astro.cookies.set(PENDING_TOPIC_COOKIE, fromLanding, PENDING_TOPIC_COOKIE_OPTIONS);
}
---

<Layout title="Zaloguj się">
  <AuthSplit>
    <div class="flex flex-col gap-2">
      <h1 class="font-display text-las text-[clamp(36px,3.4vw,48px)] leading-[1.1] font-normal">Witaj ponownie</h1>
      <p class="text-las-szary">Zaloguj się, żeby wrócić do swojego planu zajęć.</p>
    </div>
    <SignInForm serverError={serverError} client:load />
    <p class="border-linia text-las-szary border-t-[1.5px] pt-5 text-center text-base">
      Nie masz konta? <a href="/auth/signup" class="text-las hover:text-mech font-extrabold underline">Załóż konto</a>
    </p>

    <Fragment slot="panel">
      <p class="font-display text-owies text-[clamp(40px,3.9vw,56px)] leading-[1.05]">
        Jedno hasło.<br />Cały miesiąc <em class="text-szalwia">zajęć.</em>
      </p>
      <SampleDayCard
        day="Czwartek"
        theme="Wykopaliska w piaskownicy"
        activities={["Pędzelkami szukamy „kości”", "Składamy szkielet z makaronu", "Muzeum w naszej sali"]}
        class="max-w-[440px] rotate-[-2deg]"
      />
    </Fragment>
  </AuthSplit>
</Layout>
