---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/layout/AuthCard.astro";
import { buttonVariants } from "@/components/ui/button";
import { RESET_LINK_INVALID, SIGNUP_LINK_INVALID } from "@/lib/auth-error-messages";
import { cn } from "@/lib/utils";

// Where the recovery and the sign-up activation e-mails' links land. This GET
// deliberately asks Supabase nothing: the token is single-use, and school
// mailbox scanners open links to check them. Verifying here would let a
// scanner's prefetch spend the token before the teacher ever sees it - so the
// GET only renders a button, and the POST it submits (`/api/auth/confirm`)
// verifies.
//
// Only `type=recovery` and `type=email` are accepted. The parameters are
// validated for presence and shape, nothing more; whether the token is good is
// Supabase's call.
const COPY = {
  recovery: {
    heading: "Ustaw nowe hasło",
    text: "Kliknij przycisk poniżej, żeby przejść do ustawienia nowego hasła do swojego konta.",
    button: "Ustaw nowe hasło",
  },
  email: {
    heading: "Aktywuj konto",
    text: "Kliknij przycisk poniżej, żeby potwierdzić adres e-mail i zacząć planować.",
    button: "Aktywuj konto",
  },
} as const;

const tokenHash = Astro.url.searchParams.get("token_hash");
const type = Astro.url.searchParams.get("type");
if (type === "email" && !tokenHash) {
  return Astro.redirect(`/auth/signin?error=${SIGNUP_LINK_INVALID}`);
}
if (!tokenHash || (type !== "recovery" && type !== "email")) {
  return Astro.redirect(`/auth/forgot-password?error=${RESET_LINK_INVALID}`);
}
const copy = COPY[type];
---

<Layout title={copy.heading}>
  <AuthCard>
    <div class="flex flex-col gap-3">
      <h1 class="font-display text-las text-[clamp(32px,4vw,42px)] leading-[1.1] font-normal">{copy.heading}</h1>
      <p class="text-las-szary text-lg leading-normal">
        {copy.text}
      </p>
    </div>
    <form method="POST" action="/api/auth/confirm">
      <input type="hidden" name="token_hash" value={tokenHash} />
      <input type="hidden" name="type" value={type} />
      <button type="submit" class:list={cn(buttonVariants({ variant: "primary", size: "pillLg" }), "w-full")}>
        {copy.button}
      </button>
    </form>
  </AuthCard>
</Layout>
