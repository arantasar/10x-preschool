---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/layout/AuthCard.astro";
import NewPasswordForm from "@/components/auth/NewPasswordForm";
import { authErrorMessage, RESET_SESSION_MISSING } from "@/lib/auth-error-messages";

// Mock-up 13. Reached from `/api/auth/confirm` with the session the recovery
// link opened. That session is an ordinary one - nothing gates it to this page.
const { user } = Astro.locals;
if (!user) {
  return Astro.redirect(`/auth/forgot-password?error=${RESET_SESSION_MISSING}`);
}

// `?error=` carries a code, not a sentence - see `signin.astro`.
const errorCode = Astro.url.searchParams.get("error");
const serverError = errorCode ? authErrorMessage(errorCode) : null;
---

<Layout title="Ustaw nowe hasło">
  <AuthCard>
    <div class="flex flex-col gap-3">
      <h1 class="font-display text-las text-[clamp(32px,4vw,42px)] leading-[1.1] font-normal">Ustaw nowe hasło</h1>
      <p class="text-las-szary text-lg leading-normal">
        Dla konta <strong class="text-las break-all">{user.email}</strong>.
      </p>
    </div>
    <NewPasswordForm serverError={serverError} client:load />
  </AuthCard>
</Layout>
