---
import Layout from "@/layouts/Layout.astro";
import DayPlanEditor from "@/components/plan/DayPlanEditor";
import { formatPlanDate, resolvePlanDate } from "@/lib/day-plan-dates";
import { readDayPlan } from "@/lib/services/day-plan-store";
import type { DayPlanView } from "@/types";

const { user, supabase } = Astro.locals;

// The day is read from the URL and resolved before anything renders, so the
// saved plan is on screen in the first paint - no loading state, no flash of an
// empty form on a day that has one. `?date=` is also what makes a refresh, a
// bookmark and the back button all mean the same day.
const planDate = resolvePlanDate(Astro.url.searchParams.get("date"));

// "No plan" and "could not read the plan" are different answers and must not
// render the same way. Collapsing them showed the empty-day state - an invitation
// to generate - on a day that may hold an accepted plan, and generating from
// there deletes it. The writer refuses that now, but the teacher should never be
// asked the question in the first place: an unknown day gets an error and a
// reload, not a form.
let initialPlan: DayPlanView | null = null;
let readFailed = !supabase;
if (supabase) {
  try {
    initialPlan = await readDayPlan(supabase, planDate);
  } catch {
    readFailed = true;
  }
}
---

<Layout title={`Plan dnia — ${formatPlanDate(planDate)}`}>
  <div class="bg-cosmic min-h-screen p-4">
    <main class="mx-auto w-full max-w-2xl py-10">
      <header class="mb-8">
        <a href="/dashboard" class="text-sm text-purple-300 hover:underline">&larr; Wróć do pulpitu</a>
        <h1 class="mt-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Plan dnia
        </h1>
        <p class="mt-1 text-lg text-blue-100">{formatPlanDate(planDate)}</p>
        {
          !readFailed && (
            <p class="mt-2 text-blue-100/80">
              Wpisz hasło — na przykład „Andrzejki”, „Jesień” albo „Dzień Pluszowego Misia” — i wygeneruj trzy
              propozycje zajęć dla dzieci w wieku 3–6 lat. Możesz je poprawić i zaakceptować; wszystko zostaje zapisane.
            </p>
          )
        }
        {user?.email && <p class="mt-2 text-xs text-blue-100/50">Zalogowano jako {user.email}</p>}
      </header>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        {
          readFailed ? (
            <div class="rounded-xl border border-amber-400/30 bg-amber-400/10 p-4">
              <p class="font-medium text-amber-100">Nie udało się wczytać tego dnia.</p>
              <p class="mt-1 text-sm text-amber-100/80">
                Nie wiemy, czy ten dzień ma już plan, więc nie pokazujemy formularza generowania — wygenerowanie nowych
                propozycji mogłoby usunąć te, które już tu są. Odśwież stronę i spróbuj ponownie.
              </p>
              <a
                href={`/plan?date=${planDate}`}
                class="mt-3 inline-block rounded-lg bg-amber-400/20 px-4 py-2 text-sm font-medium text-amber-100 hover:bg-amber-400/30"
              >
                Odśwież
              </a>
            </div>
          ) : (
            <DayPlanEditor client:load planDate={planDate} initialPlan={initialPlan} />
          )
        }
      </div>
    </main>
  </div>
</Layout>
