---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
import DayPlanEditor from "@/components/plan/DayPlanEditor";
import { formatPlanDate, resolvePlanDate } from "@/lib/day-plan-dates";
import { readDayPlan } from "@/lib/services/day-plan-store";
import type { DayPlanView } from "@/types";

const { supabase } = Astro.locals;

// The day is read from the URL and resolved before anything renders, so the
// saved plan is on screen in the first paint - no loading state, no flash of an
// empty form on a day that has one. `?date=` is also what makes a refresh, a
// bookmark and the back button all mean the same day.
const planDate = resolvePlanDate(Astro.url.searchParams.get("date"));

// The plan is also what the header's subtitle comes from, and it is rendered as
// static SSR text rather than passed into the island.
//
// That used to be justified here with "the theme cannot change from this page,
// so the line cannot go stale". It could, and it did: this page posts no theme
// (DayPlanEditor sends plan_date, prompt and confirm_replace, nothing else),
// the writer's coalesce kept the stored one, and a teacher who regenerated
// monday from "kuchnia włoska" to "Urodziny Moniki" kept the italian subtitle
// through five generations. Reported from production 2026-09-20 and fixed in
// the writer (20260920110000): a theme the caller does not resupply survives a
// re-roll of the same hasło and is cleared when the hasło changes.
//
// So the static rendering is still correct, but for a different and narrower
// reason: every path that can change this line is a full page navigation - a
// regeneration reloads, and the island never mutates the theme. A day without
// one renders nothing, which is the same silence the month tile and the week
// board keep.
//
// "No plan" and "could not read the plan" are different answers and must not
// render the same way. Collapsing them showed the empty-day state - an invitation
// to generate - on a day that may hold an accepted plan, and generating from
// there deletes it. The writer refuses that now, but the teacher should never be
// asked the question in the first place: an unknown day gets an error and a
// reload, not a form.
let initialPlan: DayPlanView | null = null;
let readFailed = !supabase;
if (supabase) {
  try {
    initialPlan = await readDayPlan(supabase, planDate);
  } catch {
    readFailed = true;
  }
}
---

<PlannerLayout title={`Plan dnia — ${formatPlanDate(planDate)}`} active="generate">
  <main class="max-w-content px-app-gutter mx-auto w-full py-8 min-[900px]:py-10">
    <header class="mb-6">
      <a
        href={`/plan/month?month=${planDate.slice(0, 7)}`}
        class="text-las hover:text-mech inline-flex min-h-11 items-center text-[15px] font-bold underline underline-offset-4"
        >&larr; Wróć do miesiąca</a
      >
      <p class="text-mech mt-2 text-sm font-extrabold first-letter:uppercase">{formatPlanDate(planDate)}</p>
      <h1 class="font-display text-display-md text-las">Plan dnia</h1>
      {/* The day's theme - see the note on `initialPlan` above. */}
      {initialPlan?.plan.theme && <p class="text-las-szary mt-1 text-lg font-bold">{initialPlan.plan.theme}</p>}
    </header>

    {
      readFailed ? (
        <div class="border-ostrzezenie-ramka bg-ostrzezenie-tlo text-ostrzezenie rounded-row border-[1.5px] p-5">
          <p class="font-extrabold">Nie udało się wczytać tego dnia.</p>
          <p class="mt-1 text-[15px]">
            Nie wiemy, czy ten dzień ma już plan, więc nie pokazujemy formularza generowania — wygenerowanie nowych
            propozycji mogłoby usunąć te, które już tu są. Odśwież stronę i spróbuj ponownie.
          </p>
          <a
            href={`/plan?date=${planDate}`}
            class="border-ostrzezenie text-ostrzezenie mt-3 inline-flex min-h-11 items-center rounded-full border-[1.5px] px-5 font-extrabold no-underline"
          >
            Odśwież
          </a>
        </div>
      ) : (
        <DayPlanEditor
          client:load
          planDate={planDate}
          initialPlan={initialPlan}
          weekHref={`/plan/week?from=${planDate}`}
        />
      )
    }
  </main>
</PlannerLayout>
