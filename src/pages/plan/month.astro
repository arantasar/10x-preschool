---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
import MonthGrid from "@/components/plan/MonthGrid";
import MonthPdfControls from "@/components/plan/MonthPdfControls";
import { addDays, addMonths, formatMonth, resolveMonth, weeksOfMonth } from "@/lib/day-plan-dates";
import { acceptedCountLabel, monthCounts } from "@/lib/month-grid";
import { readMonthSummary } from "@/lib/services/day-plan-store";
import { PASSWORD_RESET_DONE_COOKIE, PASSWORD_RESET_DONE_COOKIE_OPTIONS } from "@/lib/reset-request";
import type { DayPlanSummary } from "@/types";

const { supabase } = Astro.locals;

// One-shot: set by `/api/auth/update-password`, consumed by the first render
// that shows it, so a reload removes the notice by construction.
const passwordResetDone = Astro.cookies.has(PASSWORD_RESET_DONE_COOKIE);
if (passwordResetDone) {
  Astro.cookies.delete(PASSWORD_RESET_DONE_COOKIE, { path: PASSWORD_RESET_DONE_COOKIE_OPTIONS.path });
}

// The entry point to the rhythm the PRD describes: a teacher plans 20-22 days
// once a month. This page generates nothing - it shows what is planned and
// leads into a week.
const month = resolveMonth(Astro.url.searchParams.get("month"));
const weeks = weeksOfMonth(month);

// The read spans the weeks, not the month: the first and last rows routinely
// reach into the neighbouring months, and a day shown in the grid without its
// status would read as "no plan" when it may hold an accepted one.
const rangeStart = weeks[0];
const rangeEnd = addDays(weeks[weeks.length - 1], 6);

// The same split every other page in this slice makes: "nothing planned" and
// "could not read" must not look alike. Here nothing destructive follows from
// getting it wrong - this page only navigates - but an empty grid that silently
// means "the read failed" would send the teacher to generate over days that
// already have plans.
let summaries: DayPlanSummary[] = [];
let readFailed = !supabase;
if (supabase) {
  try {
    summaries = await readMonthSummary(supabase, rangeStart, rangeEnd);
  } catch {
    readFailed = true;
  }
}

const previousMonth = addMonths(month, -1).slice(0, 7);
const nextMonth = addMonths(month, 1).slice(0, 7);
const plannedCount = summaries.filter((summary) => summary.plan_date.slice(0, 7) === month).length;
const counts = monthCounts(month, summaries);
const monthName = formatMonth(month);
const monthHeading = monthName.charAt(0).toUpperCase() + monthName.slice(1);

const stepLink =
  "border-obrys bg-mleko text-las hover:border-las flex size-11 shrink-0 items-center justify-center rounded-full border-[1.5px] no-underline";
---

<PlannerLayout title={`Plan miesiąca — ${monthName}`} active="plan">
  <main class="max-w-content px-app-gutter mx-auto w-full py-8 min-[900px]:py-10">
    {
      /* One line, above everything else: the month grid has to fit without a
         scroll, so the notice may cost no more than its own height. */
      passwordResetDone && (
        <p
          class="rounded-input bg-szalwia-soft text-mech-ciemny mb-4 px-4 py-2 text-[15px] font-semibold"
          role="status"
        >
          Hasło zostało zmienione. Pozostałe urządzenia zostały wylogowane.
        </p>
      )
    }
    <header class="mb-6 flex flex-col gap-4 min-[900px]:flex-row min-[900px]:items-center min-[900px]:justify-between">
      <div class="flex items-center gap-3">
        <a href={`/plan/month?month=${previousMonth}`} aria-label="Poprzedni miesiąc" class:list={stepLink}>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg
          >
        </a>
        {/* The visible heading is the month; "Plan miesiąca" stays in its name for a screen reader. */}
        <h1 class="font-display text-display-md text-las">
          <span class="sr-only">Plan miesiąca — </span>{monthHeading}
        </h1>
        <a href={`/plan/month?month=${nextMonth}`} aria-label="Następny miesiąc" class:list={stepLink}>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg
          >
        </a>
      </div>

      {
        /* The legend doubles as the month's summary: the month's working days
           by state. Hidden when the read failed - the numbers would be a guess. */
        !readFailed && (
          <ul class="text-las flex flex-wrap gap-x-5 gap-y-2 text-[15px] font-bold">
            <li class="flex items-center gap-2">
              <span class="border-mech bg-szalwia-soft inline-block size-4 rounded-[5px] border-[1.5px]" />
              {acceptedCountLabel(counts.accepted)}
            </li>
            <li class="flex items-center gap-2">
              <span class="border-obrys-przerywany bg-mleko inline-block size-4 rounded-[5px] border-[1.5px] border-dashed" />
              {counts.draft} do przejrzenia
            </li>
            <li class="flex items-center gap-2">
              <span class="bg-puste inline-block size-4 rounded-[5px]" />
              {counts.empty} bez planu
            </li>
          </ul>
        )
      }
    </header>

    {
      !readFailed && plannedCount === 0 && (
        <p class="text-las-szary mb-4">Ten miesiąc nie ma jeszcze żadnego planu. Wybierz tydzień, żeby zacząć.</p>
      )
    }

    {
      readFailed ? (
        <div class="border-ostrzezenie-ramka bg-ostrzezenie-tlo text-ostrzezenie rounded-row border-[1.5px] p-5">
          <p class="font-extrabold">Nie udało się wczytać tego miesiąca.</p>
          <p class="mt-1 text-[15px]">
            Nie wiemy, które dni mają już plan, więc nie pokazujemy siatki — pusta wyglądałaby jak miesiąc bez planów.
            Odśwież stronę i spróbuj ponownie.
          </p>
          <a
            href={`/plan/month?month=${month}`}
            class="border-ostrzezenie text-ostrzezenie mt-3 inline-flex min-h-11 items-center rounded-full border-[1.5px] px-5 font-extrabold no-underline"
          >
            Odśwież
          </a>
        </div>
      ) : (
        <>
          <MonthGrid client:load month={month} weeks={weeks} summaries={summaries} />
          {/* The print reads its own data on click (`GET /api/day-plan/month`);
              this page's read stays summaries only. Hidden when that read failed,
              like the grid - a month we could not load is not one to print. */}
          <div class="mt-6">
            <MonthPdfControls client:idle month={month} />
          </div>
        </>
      )
    }
  </main>
</PlannerLayout>
