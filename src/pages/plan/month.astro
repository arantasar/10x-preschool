---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/plan/AppHeader.astro";
import MonthGrid from "@/components/plan/MonthGrid.astro";
import { addDays, addMonths, formatMonth, resolveMonth, weeksOfMonth } from "@/lib/day-plan-dates";
import { readMonthSummary } from "@/lib/services/day-plan-store";
import type { DayPlanSummary } from "@/types";

const { supabase } = Astro.locals;

// The entry point to the rhythm the PRD describes: a teacher plans 20-22 days
// once a month. This page generates nothing - it shows what is planned and
// leads into a week.
const month = resolveMonth(Astro.url.searchParams.get("month"));
const weeks = weeksOfMonth(month);

// The read spans the weeks, not the month: the first and last rows routinely
// reach into the neighbouring months, and a day shown in the grid without its
// status would read as "no plan" when it may hold an accepted one.
const rangeStart = weeks[0];
const rangeEnd = addDays(weeks[weeks.length - 1], 6);

// The same split every other page in this slice makes: "nothing planned" and
// "could not read" must not look alike. Here nothing destructive follows from
// getting it wrong - this page only navigates - but an empty grid that silently
// means "the read failed" would send the teacher to generate over days that
// already have plans.
let summaries: DayPlanSummary[] = [];
let readFailed = !supabase;
if (supabase) {
  try {
    summaries = await readMonthSummary(supabase, rangeStart, rangeEnd);
  } catch {
    readFailed = true;
  }
}

const previousMonth = addMonths(month, -1).slice(0, 7);
const nextMonth = addMonths(month, 1).slice(0, 7);
const plannedCount = summaries.filter((summary) => summary.plan_date.slice(0, 7) === month).length;
---

<Layout title={`Plan miesiąca — ${formatMonth(month)}`}>
  <div class="bg-cosmic min-h-screen p-4">
    <main class="mx-auto w-full max-w-4xl py-10">
      <AppHeader />
      <header class="mb-8">
        <a href="/dashboard" class="text-sm text-purple-300 hover:underline">&larr; Wróć do pulpitu</a>
        <h1 class="mt-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Plan miesiąca
        </h1>
        <p class="mt-1 text-lg text-blue-100 first-letter:uppercase">{formatMonth(month)}</p>
        {
          !readFailed && (
            <p class="mt-2 text-blue-100/80">
              {plannedCount === 0
                ? "Ten miesiąc nie ma jeszcze żadnego planu. Wybierz tydzień, żeby zacząć."
                : `Zaplanowane dni w tym miesiącu: ${plannedCount}.`}
            </p>
          )
        }

        <nav class="mt-4 flex items-center gap-3 text-sm">
          <a
            href={`/plan/month?month=${previousMonth}`}
            class="rounded-lg bg-white/10 px-3 py-1.5 text-white hover:bg-white/20"
          >
            &larr; Poprzedni miesiąc
          </a>
          <a
            href={`/plan/month?month=${nextMonth}`}
            class="rounded-lg bg-white/10 px-3 py-1.5 text-white hover:bg-white/20"
          >
            Następny miesiąc &rarr;
          </a>
        </nav>
      </header>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        {
          readFailed ? (
            <div class="rounded-xl border border-amber-400/30 bg-amber-400/10 p-4">
              <p class="font-medium text-amber-100">Nie udało się wczytać tego miesiąca.</p>
              <p class="mt-1 text-sm text-amber-100/80">
                Nie wiemy, które dni mają już plan, więc nie pokazujemy siatki — pusta wyglądałaby jak miesiąc bez
                planów. Odśwież stronę i spróbuj ponownie.
              </p>
              <a
                href={`/plan/month?month=${month}`}
                class="mt-3 inline-block rounded-lg bg-amber-400/20 px-4 py-2 text-sm font-medium text-amber-100 hover:bg-amber-400/30"
              >
                Odśwież
              </a>
            </div>
          ) : (
            <MonthGrid month={month} weeks={weeks} summaries={summaries} />
          )
        }
      </div>
    </main>
  </div>
</Layout>
