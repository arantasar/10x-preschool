---
import PlannerLayout from "@/layouts/PlannerLayout.astro";
import WeekPlanBoard from "@/components/plan/WeekPlanBoard";
import { addDays, formatWeekRange, resolveWeekStart, todayIsoDate, workingDaysOf } from "@/lib/day-plan-dates";
import { normalizePendingTopic, PENDING_TOPIC_COOKIE } from "@/lib/pending-topic";
import { readWeekPlans } from "@/lib/services/day-plan-store";
import type { DayPlanView, WeekPlanView } from "@/types";

const { supabase } = Astro.locals;

// The week is resolved before anything renders, so saved days are on screen in
// the first paint - the same reason `plan.astro` resolves its day server-side.
// `?from=` accepts any day of the week and snaps to its Monday, which is what
// lets the month grid link a whole row to one URL.
const weekStart = resolveWeekStart(Astro.url.searchParams.get("from"));
const days = workingDaysOf(weekStart);

// "No plan" and "could not read the plan" must not render the same way. S-02
// learned this the expensive way: collapsing them showed the generate
// invitation on a day that may hold an accepted plan. Here the stake is five
// days at once, so a failed read shows an error and a reload, never a form.
let plans: Record<string, DayPlanView> = {};
let readFailed = !supabase;
if (supabase) {
  try {
    const saved = await readWeekPlans(supabase, days);
    plans = Object.fromEntries(saved);
  } catch {
    readFailed = true;
  }
}

const week: WeekPlanView = { weekStart, days, plans };

// A hasło the teacher typed on the landing before signing up. Read and deleted
// here in the frontmatter - response headers are still open - so it fills the
// field exactly once: a refresh shows the week as usual. It wins over the
// week's saved hasło because it is what the teacher asked for last. It only
// fills the field; nothing is generated. A failed read renders no form, so the
// cookie is kept for the reload that page offers - consuming it there would
// lose the hasło without ever showing it.
const pendingTopic = readFailed ? null : normalizePendingTopic(Astro.cookies.get(PENDING_TOPIC_COOKIE)?.value);
if (!readFailed && Astro.cookies.has(PENDING_TOPIC_COOKIE)) {
  Astro.cookies.delete(PENDING_TOPIC_COOKIE, { path: "/" });
}
const previousWeek = addDays(weekStart, -7);
const nextWeek = addDays(weekStart, 7);
const month = weekStart.slice(0, 7);

// Where the scope toggle's "Jeden dzień" leads: today when it is one of this
// week's working days, the week's Monday otherwise.
const today = todayIsoDate();
const dayHref = `/plan?date=${days.includes(today) ? today : weekStart}`;

const stepLink =
  "border-obrys bg-mleko text-las hover:border-las flex size-11 shrink-0 items-center justify-center rounded-full border-[1.5px] no-underline";
---

<PlannerLayout title={`Plan tygodnia — ${formatWeekRange(weekStart)}`} active="generate">
  <main class="max-w-content px-app-gutter mx-auto w-full py-8 min-[900px]:py-10">
    <header class="mb-6">
      <a
        href={`/plan/month?month=${month}`}
        class="text-las hover:text-mech inline-flex min-h-11 items-center text-[15px] font-bold underline underline-offset-4"
        >&larr; Wróć do miesiąca</a
      >
      <div class="mt-2 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-mech text-sm font-extrabold">{formatWeekRange(weekStart)}</p>
          <h1 class="font-display text-display-md text-las">Plan tygodnia</h1>
        </div>
        <nav aria-label="Tygodnie" class="flex items-center gap-2">
          <a href={`/plan/week?from=${previousWeek}`} aria-label="Poprzedni tydzień" class:list={stepLink}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg
            >
          </a>
          <a href={`/plan/week?from=${nextWeek}`} aria-label="Następny tydzień" class:list={stepLink}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg
            >
          </a>
        </nav>
      </div>
    </header>

    {
      readFailed ? (
        <div class="border-ostrzezenie-ramka bg-ostrzezenie-tlo text-ostrzezenie rounded-row border-[1.5px] p-5">
          <p class="font-extrabold">Nie udało się wczytać tego tygodnia.</p>
          <p class="mt-1 text-[15px]">
            Nie wiemy, które dni mają już plan, więc nie pokazujemy formularza generowania — moglibyśmy nadpisać pracę,
            która już tu jest. Odśwież stronę i spróbuj ponownie.
          </p>
          <a
            href={`/plan/week?from=${weekStart}`}
            class="border-ostrzezenie text-ostrzezenie mt-3 inline-flex min-h-11 items-center rounded-full border-[1.5px] px-5 font-extrabold no-underline"
          >
            Odśwież
          </a>
        </div>
      ) : (
        <WeekPlanBoard client:load week={week} initialPrompt={pendingTopic ?? undefined} dayHref={dayHref} />
      )
    }
  </main>
</PlannerLayout>
