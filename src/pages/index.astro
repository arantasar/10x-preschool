---
import { AccountDeletedNotice } from "@/components/AccountDeletedNotice";
import Welcome from "@/components/Welcome.astro";
import Layout from "@/layouts/Layout.astro";
import { ACCOUNT_DELETED_COOKIE, ACCOUNT_DELETED_COOKIE_OPTIONS } from "@/lib/account-settings";

// The signed-in app starts at the month, not here. The decision lives in the
// page that makes it rather than in the middleware: the middleware answers one
// question - "does this route need a session" - and giving it the shape of the
// route map would blur that role. `Astro.locals.user` is already resolved by
// the middleware for every request, so this costs no extra Supabase call.
// `POST /api/auth/signout` redirects here after clearing the cookie, so the
// user is null by then and the welcome page renders - no redirect loop.
const { user } = Astro.locals;
if (user) {
  return Astro.redirect("/plan/month");
}

// One-shot: set by `/api/auth/delete-account` after the account is gone,
// consumed by the render that shows it, so a reload removes the notice.
const accountDeleted = Astro.cookies.has(ACCOUNT_DELETED_COOKIE);
if (accountDeleted) {
  Astro.cookies.delete(ACCOUNT_DELETED_COOKIE, { path: ACCOUNT_DELETED_COOKIE_OPTIONS.path });
}
---

<Layout>
  <Welcome />
  {/* Fixed, so its place in the DOM does not move the layout; last, so the close button comes last in tab order. */}
  {accountDeleted && <AccountDeletedNotice client:load />}
</Layout>
