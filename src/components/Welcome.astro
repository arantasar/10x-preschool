---
// The signed-out landing ("Ogród", mock-ups 01 and 05). What it deliberately
// does not show from the mock-ups, and why:
// - no promise that nothing enters the plan unapproved: a generated day is saved
//   as a draft at once, so the sentence would be false (`pl-landing-copy`);
// - no generation for a guest: the topic field only carries the hasło into
//   sign-up (`?haslo=`), and the planner is still behind the login;
// - example cards show three activities and no category / duration / place
//   (the contract is 3 per day; categories are M-04);
// - the month illustration has no week-theme labels and no "Zobacz przykładowy
//   plan" - the grid cannot show week themes yet (`design-planner`, N4).
import Blob from "@/components/brand/Blob.astro";
import MarketingHeader from "@/components/layout/MarketingHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import HowItWorksSteps from "@/components/marketing/HowItWorksSteps.astro";
import SampleDayCard from "@/components/marketing/SampleDayCard.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const sampleDays = [
  {
    day: "Poniedziałek",
    theme: "Tropem dinozaurów",
    activities: ["Wielkie kroki brontozaura", "Ślady na papierowej ścieżce", "Kto tu przeszedł?"],
  },
  {
    day: "Wtorek",
    theme: "Jajo dinozaura",
    activities: ["Jajo z masy solnej", "Wielkie wykluwanie", "Dinozaurza kołysanka"],
  },
  {
    day: "Środa",
    theme: "Mali paleontolodzy",
    activities: ["Kości w piaskownicy", "Zagadki pacynki-paleontologa", "Taniec dinozaurów"],
  },
];

// Illustration only: day themes in three states the month grid really has -
// accepted, draft, and no plan.
type Cell = { theme: string; accepted: boolean } | null;
const illustrationWeeks: { label: string; days: Cell[] }[] = [
  {
    label: "5–9 października",
    days: [
      { theme: "Tropem dinozaurów", accepted: true },
      { theme: "Jajo dinozaura", accepted: true },
      { theme: "Mali paleontolodzy", accepted: false },
      { theme: "Wykopaliska", accepted: false },
      { theme: "Dinozaurowy taniec", accepted: false },
    ],
  },
  {
    label: "12–16 października",
    days: [
      { theme: "Kto mieszka w domu?", accepted: true },
      { theme: "Budujemy z pudełek", accepted: true },
      { theme: "Domowe dźwięki", accepted: true },
      { theme: "Zwierzęta w domu", accepted: true },
      { theme: "Porządki na wesoło", accepted: true },
    ],
  },
  { label: "19–23 października", days: [null, null, null, null, null] },
];
---

<div class="relative flex min-h-screen flex-col overflow-hidden">
  <Blob shape="a" color="sage" class="-top-40 -right-30 h-[340px] w-[380px] sm:h-[520px] sm:w-[600px]" />
  <Blob
    shape="b"
    color="apricot-soft"
    class="top-[430px] -left-40 h-[240px] w-[260px] sm:top-[300px] sm:-left-32 sm:h-[300px] sm:w-[320px]"
  />
  <Blob shape="circle" color="apricot" class="top-[140px] right-[250px] hidden size-[60px] lg:block" />

  <MarketingHeader />

  <main class="relative z-10 flex flex-col">
    <section
      class="sm:px-gutter flex flex-col items-start gap-6 px-5 pt-8 text-left sm:items-center sm:gap-[26px] sm:pt-16 sm:text-center"
      aria-labelledby="hero-heading"
    >
      <p class="eyebrow">
        Dla nauczycieli przedszkolnych<span class="hidden sm:inline"> · dzieci 3–6 lat</span>
      </p>
      <h1 id="hero-heading" class="font-display text-display-xl text-las font-normal">
        Jedno hasło.<br />Cały miesiąc <em class="text-mech">zajęć.</em>
      </h1>
      <p class="text-las-szary sm:text-lead max-w-[660px] text-lg leading-relaxed">
        Wpisz temat, np. „Dinozaury”, a dostaniesz gotowe propozycje aktywności na każdy dzień. Zamiast układać 22 dni
        od zera — przeglądasz, poprawiasz, zatwierdzasz.
      </p>

      {
        /* GET, not POST: the hasło rides to sign-up as `?haslo=`, where the page
          keeps it for after the first login. Nothing is generated for a guest. */
      }
      <form method="GET" action="/auth/signup" class="flex w-full max-w-[760px] flex-col gap-3.5 pt-2 sm:items-center">
        <div
          class="sm:bg-mleko sm:shadow-input sm:has-[input:focus-visible]:outline-morela flex w-full flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-2 sm:rounded-full sm:py-2 sm:pr-2 sm:pl-7 sm:has-[input:focus-visible]:outline-3 sm:has-[input:focus-visible]:outline-offset-2 sm:has-[input:focus-visible]:outline-solid"
        >
          <label for="haslo" class="text-mech text-sm font-extrabold sm:text-[15px] sm:font-bold">Temat</label>
          <input
            id="haslo"
            name="haslo"
            type="text"
            maxlength="200"
            autocomplete="off"
            placeholder="np. Dinozaury"
            class="bg-mleko text-las shadow-input placeholder:text-las-szary/70 min-w-0 flex-1 rounded-[18px] px-[18px] py-4 text-xl font-bold placeholder:font-semibold sm:rounded-none sm:bg-transparent sm:p-3 sm:text-[22px] sm:shadow-none sm:focus-visible:outline-none"
          />
          <button
            type="submit"
            class:list={cn(
              buttonVariants({ variant: "primary", size: "pillLg" }),
              "w-full sm:w-auto sm:px-[26px] sm:py-4",
            )}
          >
            Wygeneruj propozycje
          </button>
        </div>
        <p class="text-las-szary text-center text-[15px]">Najpierw załóż darmowe konto — hasło na Ciebie poczeka.</p>
      </form>
    </section>

    <section class="sm:px-gutter grid gap-5 px-5 pt-14 sm:pt-16 md:grid-cols-3 md:gap-6" aria-label="Przykładowe dni">
      {
        sampleDays.map((sample) => (
          <SampleDayCard day={sample.day} theme={sample.theme} activities={sample.activities} />
        ))
      }
    </section>

    <section class="sm:px-gutter flex flex-col gap-8 px-5 pt-20 md:gap-10 md:pt-[140px]" aria-labelledby="how-heading">
      <h2 id="how-heading" class="font-display text-display-lg text-las font-normal">Jak to działa</h2>
      <HowItWorksSteps />
    </section>

    <section
      class="sm:px-gutter grid items-center gap-10 px-5 pt-20 md:pt-[140px] lg:grid-cols-12 lg:gap-12"
      aria-labelledby="month-heading"
    >
      <div class="flex flex-col gap-5 lg:col-span-5">
        <p class="eyebrow">Przegląd miesiąca</p>
        <h2 id="month-heading" class="font-display text-display-lg text-las font-normal">
          Cały miesiąc na jednej siatce
        </h2>
        <p class="text-las-szary text-lg leading-relaxed">
          Dni zatwierdzone, dni robocze i te, które jeszcze czekają na plan. Od razu widać, gdzie brakuje zajęć.
        </p>
      </div>

      {/* Decorative: the paragraph beside it says everything this shows. */}
      <div
        class="bg-mleko shadow-panel flex flex-col gap-[18px] rounded-[32px] p-5 sm:p-8 lg:col-span-7"
        aria-hidden="true"
      >
        <p class="font-display text-2xl">Październik</p>
        {
          illustrationWeeks.map((week) => (
            <div class="flex flex-col gap-2">
              <p class="text-mech text-[13px] font-extrabold">{week.label}</p>
              <div class="grid grid-cols-5 gap-2">
                {week.days.map((cell) =>
                  cell ? (
                    <div
                      class:list={cn(
                        "min-h-16 rounded-xl p-2 text-[13px] leading-snug font-bold sm:p-3",
                        cell.accepted
                          ? "bg-szalwia-soft text-mech-ciemny"
                          : "border-obrys-przerywany text-las-szary border-[1.5px] border-dashed",
                      )}
                    >
                      <span class="hidden sm:inline">{cell.theme}</span>
                    </div>
                  ) : (
                    <div class="bg-owies-ciemny min-h-16 rounded-xl" />
                  ),
                )}
              </div>
            </div>
          ))
        }
        <ul class="text-las-szary flex flex-wrap gap-x-5 gap-y-2 pt-1 text-[13px] font-bold">
          <li class="flex items-center gap-2"><span class="bg-szalwia-soft size-3.5 rounded"></span>zatwierdzony</li>
          <li class="flex items-center gap-2">
            <span class="border-obrys-przerywany size-3.5 rounded border-[1.5px] border-dashed"></span>roboczy
          </li>
          <li class="flex items-center gap-2"><span class="bg-owies-ciemny size-3.5 rounded"></span>bez planu</li>
        </ul>
      </div>
    </section>

    <section class="sm:px-gutter px-5 pt-20 pb-20 md:pt-[140px] md:pb-[100px]" aria-labelledby="cta-heading">
      <div
        class="rounded-card bg-las text-owies md:rounded-panel relative flex flex-col gap-8 overflow-hidden px-7 py-12 md:flex-row md:items-center md:justify-between md:px-14 md:py-16"
      >
        <Blob shape="circle" color="forest" class="-right-16 -bottom-24 size-[260px]" />
        <div class="relative z-10 flex max-w-[560px] flex-col gap-4">
          <h2 id="cta-heading" class="font-display text-display-lg text-owies font-normal">
            Zacznij od jednego hasła.
          </h2>
          <p class="text-szalwia text-lg">Załóż konto i wygeneruj pierwsze propozycje na najbliższy tydzień.</p>
        </div>
        <div class="relative z-10 flex flex-col items-start gap-3 md:items-center">
          <a href="/auth/signup" class:list={cn(buttonVariants({ variant: "inverse", size: "pillLg" }))}>Załóż konto</a>
          <a
            href="/auth/signin"
            class="text-owies hover:text-szalwia inline-flex min-h-11 items-center font-bold underline underline-offset-4"
          >
            Mam już konto — zaloguj się
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</div>
