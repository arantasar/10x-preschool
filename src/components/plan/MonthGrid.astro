---
import { addDays, workingDaysOf } from "@/lib/day-plan-dates";
import type { DayPlanSummary } from "@/types";

/**
 * The month as rows of weeks. Display only - no state, so an Astro component
 * rather than a React island (the rule in CLAUDE.md).
 *
 * The unit of action here is the week, not the day: each row links to
 * `/plan/week?from=`, which is where generating actually happens. Days link to
 * `/plan?date=` for a single-day plan. This grid generates nothing itself.
 */

interface Props {
  /** `YYYY-MM` - the month being shown. */
  month: string;
  /** Mondays of every week touching the month, from `weeksOfMonth`. */
  weeks: readonly string[];
  /** What the teacher has planned in the range, keyed by `plan_date`. */
  summaries: readonly DayPlanSummary[];
}

const { month, weeks, summaries } = Astro.props;

const byDate = new Map(summaries.map((summary) => [summary.plan_date, summary]));
const WEEKDAY_HEADS = ["pon", "wt", "śr", "czw", "pt", "sob", "nd"];

function dayNumber(isoDate: string): string {
  return String(Number(isoDate.slice(8, 10)));
}

/**
 * Hasło and theme as one string, for the surfaces that cannot truncate.
 *
 * Both tile lines clip at roughly a dozen characters, so the tooltip and the
 * accessible name are the only places the whole text survives. They have to
 * agree, hence one function rather than two template literals.
 */
function tileText(summary: DayPlanSummary): string {
  return summary.theme ? `${summary.prompt} — ${summary.theme}` : summary.prompt;
}

/**
 * The tile's accessible name: which day, what is on it, and what state it is in.
 *
 * The content sits before the state on purpose - a teacher tabbing across a
 * planned week wants to hear which day is which, and "zaakceptowany" is the
 * qualifier on that, not the headline.
 */
function tileLabel(isoDate: string, summary: DayPlanSummary | undefined): string {
  if (!summary) {
    return `Plan na ${isoDate} — brak planu`;
  }
  return `Plan na ${isoDate} — ${tileText(summary)} — ${summary.accepted ? "zaakceptowany" : "roboczy"}`;
}
---

<div class="space-y-3">
  <div class="grid grid-cols-[1fr_auto] gap-3">
    <div class="grid grid-cols-7 gap-1.5">
      {
        WEEKDAY_HEADS.map((head, index) => (
          <span class:list={["px-1 text-center text-xs", index > 4 ? "text-blue-100/30" : "text-blue-100/60"]}>
            {head}
          </span>
        ))
      }
    </div>
    <span class="w-28"></span>
  </div>

  {
    weeks.map((monday) => {
      // Five working days plus the weekend, so Saturday and Sunday are visible
      // but visibly outside what "generate the week" covers.
      const days = [...workingDaysOf(monday), addDays(monday, 5), addDays(monday, 6)];
      return (
        <div class="grid grid-cols-[1fr_auto] items-center gap-3">
          <div class="grid grid-cols-7 gap-1.5">
            {days.map((date, index) => {
              const summary = byDate.get(date);
              const inMonth = date.slice(0, 7) === month;
              const isWeekend = index > 4;
              return (
                <a
                  href={`/plan?date=${date}`}
                  aria-label={tileLabel(date, summary)}
                  class:list={[
                    "flex min-h-16 flex-col justify-between rounded-lg border p-1.5 transition-colors",
                    summary?.accepted && "border-emerald-400/40 bg-emerald-500/15 hover:bg-emerald-500/25",
                    summary && !summary.accepted && "border-purple-400/40 bg-purple-500/15 hover:bg-purple-500/25",
                    !summary && "border-white/10 bg-white/5 hover:bg-white/10",
                    !inMonth && "opacity-40",
                    isWeekend && !summary && "border-dashed",
                  ]}
                >
                  <span class:list={["text-xs tabular-nums", isWeekend ? "text-blue-100/40" : "text-white"]}>
                    {dayNumber(date)}
                  </span>
                  {summary && (
                    // The hasło is dimmed and the theme is not: five days of one
                    // hasło differ only in the second line, so that is the line
                    // the eye should land on. A day without a theme keeps the
                    // single line it has today - no placeholder, no reserved
                    // gap. `null` there is a permanent state, not an omission.
                    <div class="min-w-0" title={tileText(summary)}>
                      <span class="block truncate text-[10px] leading-tight text-blue-100/50">{summary.prompt}</span>
                      {summary.theme && (
                        <span class="block truncate text-[10px] leading-tight text-purple-200/90">{summary.theme}</span>
                      )}
                    </div>
                  )}
                </a>
              );
            })}
          </div>
          <a
            href={`/plan/week?from=${monday}`}
            class="w-28 rounded-lg bg-white/10 px-2 py-2 text-center text-xs font-medium text-white transition-colors hover:bg-white/20"
          >
            Zaplanuj tydzień
          </a>
        </div>
      );
    })
  }

  <div class="flex flex-wrap gap-4 pt-2 text-xs text-blue-100/60">
    <span class="flex items-center gap-1.5">
      <span class="inline-block size-3 rounded border border-emerald-400/40 bg-emerald-500/15"></span>
      zaakceptowany
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block size-3 rounded border border-purple-400/40 bg-purple-500/15"></span>
      roboczy
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block size-3 rounded border border-white/10 bg-white/5"></span>
      brak planu
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block size-3 rounded border border-dashed border-white/10 bg-white/5"></span>
      weekend — poza generowaniem tygodnia
    </span>
  </div>
</div>
