---
// The account-settings shell: eyebrow and title, the section menu on the left
// and the content column (default slot). A port of the design package's
// `SettingsLayout` (`context/foundation/design/src/components/account/`) to the
// project's Tailwind tokens.
//
// New sections go into the menu below. S-18 (`account-deletion`) adds „Usuń
// konto” as the last regular item, in the danger colour; „Wyloguj się” stays
// below the divider. At ≤ 900 px the menu becomes a horizontal pill row above
// the content.
//
// The cards in the slot carry the design's `set-card` look themselves:
// `bg-mleko rounded-card flex flex-col px-5 py-6 min-[901px]:px-9 min-[901px]:py-8`.
import { SETTINGS_PATH } from "@/lib/account-settings";
import { cn } from "@/lib/utils";

interface Props {
  active: string;
}

const { active } = Astro.props;

const itemClass =
  "text-las hover:bg-owies hover:text-las flex min-h-11 items-center gap-3 rounded-[14px] px-3.5 py-2.5 text-base font-bold whitespace-nowrap no-underline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-las focus-visible:outline-solid";
const activeClass = "bg-szalwia-soft hover:bg-szalwia-soft font-extrabold";
---

<div class="px-app-gutter mx-auto flex w-full max-w-[1100px] flex-col gap-8 pt-12 pb-16">
  <header class="flex flex-col gap-1.5">
    <p class="eyebrow">Konto</p>
    <h1 class="font-display text-las text-[clamp(34px,3.2vw,44px)] leading-[1.1]">Ustawienia</h1>
  </header>
  <div class="grid grid-cols-1 items-start gap-5 min-[901px]:grid-cols-[260px_minmax(0,1fr)] min-[901px]:gap-10">
    <nav
      aria-label="Ustawienia"
      class="bg-mleko flex flex-row gap-1 overflow-x-auto rounded-[24px] p-2 min-[901px]:sticky min-[901px]:top-6 min-[901px]:flex-col min-[901px]:p-3.5"
    >
      <a
        href={SETTINGS_PATH}
        aria-current={active === "konto" ? "page" : undefined}
        class:list={cn(itemClass, active === "konto" && activeClass)}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg
        >
        Konto i hasło
      </a>
      <hr class="bg-linia mx-1.5 my-2 hidden h-[1.5px] border-0 min-[901px]:block" />
      {/* The design's `/wyloguj` link does not exist: signing out is a POST. */}
      <form method="POST" action="/api/auth/signout" class="contents">
        <button type="submit" class:list={cn(itemClass, "cursor-pointer text-left")}>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l5-5-5-5M15 12H4"></path></svg
          >
          Wyloguj się
        </button>
      </form>
    </nav>
    <div class="flex min-w-0 flex-col gap-6"><slot /></div>
  </div>
</div>
