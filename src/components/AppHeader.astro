---
// The only place in the signed-in app that carries the session identity and the
// way out of it. Deliberately not an extension of `layout/MarketingHeader.astro`:
// that one is the signed-out pages' header, and its fate is unrelated to the
// fate of this shell.
//
// The avatar and the address together are one link into the account settings
// (`/ustawienia`, S-17): a bare avatar was not recognisable as a way in, and the
// address says whose account this is - on a shared preschool computer that
// matters. Below 721 px the address hides and the avatar stands alone.
// "Wyloguj się" stays a visible submit button - it is the way out, and the e2e
// setup waits for it.
import Logo from "@/components/brand/Logo.astro";
import StableLabel from "@/components/layout/StableLabel.astro";
import { SETTINGS_PATH } from "@/lib/account-settings";
import { cn } from "@/lib/utils";

interface Props {
  active?: "plan" | "generate" | "account";
}

const { active } = Astro.props;
const { user } = Astro.locals;

const items = [
  { key: "plan", label: "Plan miesiąca", href: "/plan/month" },
  // No `?from=`: the week page resolves a missing parameter to the current week.
  { key: "generate", label: "Nowe propozycje", href: "/plan/week" },
] as const;

const initial = user?.email?.charAt(0).toUpperCase() ?? "";
---

<header
  class="border-linia bg-mleko px-app-gutter flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b-[1.5px] py-3"
>
  <Logo href="/plan/month" label="Temio — plan miesiąca" />
  <nav aria-label="Główna" class="order-3 flex w-full gap-1.5 min-[721px]:order-none min-[721px]:w-auto">
    {
      items.map((item) => (
        <a
          href={item.href}
          aria-current={active === item.key ? "page" : undefined}
          class:list={cn(
            "text-las hover:text-mech inline-flex min-h-11 flex-1 items-center justify-center rounded-full px-3 py-2.5 text-[15px] font-bold no-underline min-[721px]:flex-none min-[721px]:px-[18px] min-[721px]:text-base",
            active === item.key && "bg-szalwia-soft hover:text-las font-extrabold",
          )}
        >
          <StableLabel label={item.label} />
        </a>
      ))
    }
  </nav>
  <div class="flex items-center gap-1.5">
    {
      initial && (
        <a
          href={SETTINGS_PATH}
          title="Ustawienia konta"
          aria-current={active === "account" ? "page" : undefined}
          class:list={cn(
            "text-las hover:bg-owies hover:text-las flex min-h-11 items-center gap-2.5 rounded-full no-underline min-[721px]:pr-4",
            // The current page, like the current item of the main nav.
            active === "account" && "bg-szalwia-soft hover:bg-szalwia-soft",
          )}
        >
          <span
            aria-hidden="true"
            class="bg-morela-soft flex size-11 shrink-0 items-center justify-center rounded-full text-base font-extrabold"
          >
            {initial}
          </span>
          {/* The name starts with what the link does and keeps the visible
              address in it, so voice control finds it by either. */}
          <span class="sr-only">Ustawienia konta: </span>
          <span class="text-las-szary hidden text-[15px] font-semibold min-[721px]:inline">{user?.email}</span>
        </a>
      )
    }
    {/* The signed-in way to the FAQ and the contact form (S-19). */}
    <a
      href="/pomoc"
      class="text-las hover:text-mech inline-flex min-h-11 items-center rounded-full px-3 text-[15px] font-bold no-underline"
    >
      Pomoc
    </a>
    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        class="text-las hover:text-mech inline-flex min-h-11 cursor-pointer items-center rounded-full px-3 text-[15px] font-bold"
      >
        Wyloguj się
      </button>
    </form>
  </div>
</header>
