---
// The only place in the signed-in app that carries the session identity and the
// way out of it. Deliberately not an extension of `layout/MarketingHeader.astro`:
// that one is the signed-out pages' header, and its fate is unrelated to the
// fate of this shell.
//
// Everything about the account sits behind one button on the right, the account
// menu (design mock-up 19): the avatar with the initial opens „Zalogowano jako
// <email>”, Ustawienia konta, Pomoc, Kontakt and „Wyloguj się”. The address is
// no longer in the bar itself - it is at the top of the menu and in the
// button's accessible name, so on a shared preschool computer whose account
// this is stays one click away. Sign-out lives in the menu, still as a POST.
import AccountMenu from "@/components/account/AccountMenu";
import Logo from "@/components/brand/Logo.astro";
import StableLabel from "@/components/layout/StableLabel.astro";
import { cn } from "@/lib/utils";

interface Props {
  active?: "plan" | "generate" | "account";
}

const { active } = Astro.props;
const { user } = Astro.locals;

const items = [
  { key: "plan", label: "Plan miesiąca", href: "/plan/month" },
  // No `?from=`: the week page resolves a missing parameter to the current week.
  { key: "generate", label: "Nowe propozycje", href: "/plan/week" },
] as const;
---

<header
  class="border-linia bg-mleko px-app-gutter flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b-[1.5px] py-3"
>
  <Logo href="/plan/month" label="Temio — plan miesiąca" />
  <nav aria-label="Główna" class="order-3 flex w-full gap-1.5 min-[721px]:order-none min-[721px]:w-auto">
    {
      items.map((item) => (
        <a
          href={item.href}
          aria-current={active === item.key ? "page" : undefined}
          class:list={cn(
            "text-las hover:text-mech inline-flex min-h-11 flex-1 items-center justify-center rounded-full px-3 py-2.5 text-[15px] font-bold no-underline min-[721px]:flex-none min-[721px]:px-[18px] min-[721px]:text-base",
            active === item.key && "bg-szalwia-soft hover:text-las font-extrabold",
          )}
        >
          <StableLabel label={item.label} />
        </a>
      ))
    }
  </nav>
  <div class="flex items-center">
    {
      /* Any signed-in user gets the menu, with or without an address: it is
        the only way out of the app on these screens. */
    }
    {user && <AccountMenu client:load email={user.email ?? ""} current={active === "account"} />}
  </div>
</header>
