---
// Long legal text (Regulamin, Polityka prywatności) - mock-up 10, ported from
// the design package's `LegalLayout.astro` onto this project's tokens. Left: the
// table of contents; right: the rendered Markdown in the default slot. ≤ 900 px
// the contents fold into a <details> above the text.
//
// The Markdown brings its own heading ids (Astro slugs them), so `toc` is the
// page's `getHeadings()` cut to `##` - no hand-written anchors to drift.
//
// The prose styles reach into rendered Markdown, hence `:global` below: the
// elements come from the Markdown pipeline, not from this template.
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  toc: TocItem[];
  effectiveDate?: string;
  version?: string;
  /** When the document binds accounts created before `effectiveDate` (Regulamin § 14 ust. 5). */
  existingAccountsDate?: string;
  /** The line above „Napisz do nas”. */
  question: string;
}

const { title, toc, effectiveDate, version, existingAccountsDate, question } = Astro.props;
---

<div
  class="sm:px-gutter grid items-start gap-8 px-5 pt-6 pb-16 min-[901px]:grid-cols-[280px_minmax(0,1fr)] min-[901px]:gap-20 sm:pt-14 sm:pb-24"
>
  <nav aria-label="Spis treści" class="bg-mleko rounded-card p-5 min-[901px]:sticky min-[901px]:top-6">
    <details open>
      <summary
        class="text-mech cursor-pointer px-3 pt-1.5 pb-2.5 text-[13px] font-extrabold tracking-[1.5px] uppercase"
      >
        Spis treści
      </summary>
      <ol class="flex flex-col gap-0.5">
        {
          toc.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="text-las hover:bg-szalwia-soft block rounded-xl px-3 py-2.5 text-[15px] font-bold no-underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
    </details>
  </nav>

  <article class="flex max-w-[760px] min-w-0 flex-col gap-11">
    <header class="flex flex-col gap-3.5">
      <h1 class="font-display text-las text-[clamp(44px,4.4vw,64px)] leading-[1.05] font-normal">{title}</h1>
      {
        (effectiveDate ?? version) && (
          <p class="text-mech flex flex-wrap gap-x-5 gap-y-1 text-[15px] font-bold">
            {effectiveDate && <span>Obowiązuje od: {effectiveDate}</span>}
            {version && <span>Wersja: {version}</span>}
            {existingAccountsDate && <span>Dla kont założonych wcześniej: od {existingAccountsDate}</span>}
          </p>
        )
      }
    </header>

    <div class="legal-prose">
      <slot />
    </div>

    <div class="border-linia flex flex-wrap items-center justify-between gap-5 border-t-[1.5px] pt-7">
      <span class="text-las-szary text-base">{question}</span>
      <a href="/kontakt" class:list={cn(buttonVariants({ variant: "outlinePill", size: "pill" }))}>Napisz do nas</a>
    </div>
  </article>
</div>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }

  .legal-prose {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-las-szary);
  }
  .legal-prose :global(h2) {
    margin-top: 30px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-las);
    scroll-margin-top: 24px;
  }
  .legal-prose :global(h3) {
    margin-top: 12px;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--color-las);
    scroll-margin-top: 24px;
  }
  .legal-prose :global(strong) {
    color: var(--color-las);
  }
  .legal-prose :global(a) {
    color: var(--color-las);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .legal-prose :global(a:hover) {
    color: var(--color-mech);
  }
  .legal-prose :global(ol),
  .legal-prose :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 24px;
  }
  .legal-prose :global(ol) {
    list-style: decimal;
  }
  .legal-prose :global(ul) {
    list-style: disc;
  }
  .legal-prose :global(li > ol),
  .legal-prose :global(li > ul) {
    margin-top: 10px;
  }
  /* „Najważniejsze w skrócie” - the info tone of the package's `Notice.astro`. */
  .legal-prose :global(blockquote) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-radius: 16px;
    padding: 18px 22px;
    background: var(--color-maslo-soft);
    color: var(--color-ostrzezenie);
    font-size: 16px;
    line-height: 1.55;
  }
  .legal-prose :global(blockquote strong) {
    color: inherit;
  }
  /* A table scrolls inside itself, never the page (polityka pkt 3 and 7 at 360 px). */
  .legal-prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
  }
  .legal-prose :global(th),
  .legal-prose :global(td) {
    min-width: 160px;
    border-bottom: 1.5px solid var(--color-linia);
    padding: 10px 14px 10px 0;
    text-align: left;
    vertical-align: top;
  }
  .legal-prose :global(th) {
    color: var(--color-las);
    font-weight: 800;
  }
  .legal-prose :global(code) {
    border-radius: 6px;
    background: var(--color-owies-ciemny);
    padding: 1px 6px;
    font-size: 14px;
    overflow-wrap: anywhere;
  }
</style>
