---
// The "Ogród" wordmark: a leaf-shaped mark and the name in Young Serif.
// Always a link home - on the public pages that is the landing, and a signed-in
// teacher who follows it is redirected to the month by `index.astro`.
import { cn } from "@/lib/utils";

interface Props {
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { size = "md", class: className } = Astro.props;

const markSize = {
  sm: "size-[26px] rounded-[50%_50%_50%_6px]",
  md: "size-[30px] rounded-logo",
  lg: "size-[34px] rounded-logo",
};
const wordSize = { sm: "text-xl", md: "text-[22px]", lg: "text-[25px]" };
---

<a
  href="/"
  class:list={cn("text-las inline-flex min-h-11 items-center gap-2.5 no-underline", className)}
  aria-label="10xPreschool — strona główna"
>
  <span class:list={cn("bg-las block", markSize[size])} aria-hidden="true"></span>
  <span class:list={cn("font-display leading-none", wordSize[size])} aria-hidden="true">10xPreschool</span>
</a>
