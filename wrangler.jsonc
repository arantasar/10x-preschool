{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "10x-preschool",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b85f34f00ac9467884163d3b58cd20ad",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // The old production host redirects to the canonical origin
  // (`src/lib/canonical-host.ts`). Exact host match: preview hosts are untouched.
  // Rollback: removing this block stops new redirects, but browsers cache the
  // 301/308 indefinitely, so anyone who already visited the old host stays
  // redirected.
  "vars": {
    "LEGACY_HOST": "10x-preschool.janusz-guzowski.workers.dev",
    "CANONICAL_ORIGIN": "https://temio.pl",
  },
}
